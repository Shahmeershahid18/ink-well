# Supabase project credentials — copy this file to .env.local and fill in.
# Both values are safe in the browser; the service_role key is NOT and must never
# appear in this file or anywhere client-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
